# === Java/Gradle project ignores ===

# Compiled class files
*.class

# Package files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Logs
*.log
hs_err_pid*
replay_pid*

# Build / output directories (Removed leading slashes to catch nested sub-modules)
.gradle/
build/
out/
bin/
tmp/
dist/
target/

# Recursive safety net for deeply nested project build/target dirs
**/build/
**/.gradle/
**/target/
**/bin/
**/out/

# Gradle cache and build dirs
**/gradle/**/build/

# Eclipse
.classpath
.project
.settings/
.metadata/
.externalToolBuilders/
.recommenders
.buildpath
**/.settings/
**/.classpath
**/.project

# IntelliJ IDEA (Catches .idea folders globally)
.idea/
**/.idea/
*.iml
**/*.iml
*.iws

# NetBeans
nbproject/private/
nbbuild/
.nb-gradle/
**/nbproject/

# VS Code
.vscode/
**/.vscode/

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# macOS
.DS_Store
**/.DS_Store

# Windows
Thumbs.db
**/Thumbs.db

# Temporary and swap files
*.tmp
*.temp
*.bak
*.swp

# Test reports
**/test-results/
**/test-output/

# Generated sources (if any)
**/generated/

# Lombok annotation processing (IDE caches)
**/lombok-generated/

# Coverage reports
coverage/
*.lcov

# End of file
