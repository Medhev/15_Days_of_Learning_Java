# === Java/Gradle project ignores ===

# Compiled class files
*.class

# Package files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Logs
*.log
hs_err_pid*
replay_pid*

# Build / output directories
/.gradle/
/build/
/out/
/bin/
/tmp/
/dist/
/target/

# Gradle cache and build dirs
/gradle/**/build/

# Eclipse
.classpath
.project
.settings/
.metadata/
.externalToolBuilders/
.recommenders
.buildpath

# IntelliJ IDEA
/.idea/
*.iml
*.iws

# NetBeans
nbproject/private/
nbbuild/
.nb-gradle/

# VS Code
.vscode/

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# macOS
.DS_Store

# Windows
Thumbs.db

# Temporary and swap files
*.tmp
*.temp
*.bak
*.swp

# Test reports
/test-results/
/test-output/

# Generated sources (if any)
/generated/

# Lombok annotation processing (IDE caches)
/lombok-generated/

# Coverage reports
coverage/
*.lcov

# User-specific Gradle cache
.gradle/

# Other IDEs
.idea_modules/

# End of file
